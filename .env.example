# Copy to .env (never commit .env). Placeholders only.

# --- AI provider: "anthropic" (default), "openai", or "gemini" ---
AI_PROVIDER=anthropic
# Optional. Leave blank to use the provider default listed in README.
AI_MODEL=

ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
# Gemini also accepts GOOGLE_API_KEY if GEMINI_API_KEY is not set.
GEMINI_API_KEY=your-gemini-api-key-here

AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=3000

# --- Database ---
# Local default (SQLite file, created automatically):
DATABASE_URL=sqlite:///data/mindtrace.db
# Hosted PostgreSQL example (use for Streamlit Community Cloud persistence):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Copy to .streamlit/secrets.toml for local use (git-ignored), or paste into
# Streamlit Community Cloud > App settings > Secrets. Placeholders only.

AI_PROVIDER = "anthropic"          # or "openai" or "gemini"
AI_MODEL = ""                      # optional override
ANTHROPIC_API_KEY = "your-anthropic-api-key-here"
# OPENAI_API_KEY = "your-openai-api-key-here"
# GEMINI_API_KEY = "your-gemini-api-key-here"

# Persistent hosted PostgreSQL (recommended on Streamlit Community Cloud):
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
